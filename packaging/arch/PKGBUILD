# Local-checkout build for development: packages THIS working tree, including
# uncommitted changes.   cd packaging/arch && makepkg -si
# The AUR package (fetches a release tag) is packaging/aur/PKGBUILD; keep the
# dependency lists and package() steps of both files in sync.
# alizyd.install is a symlink to ../aur/alizyd.install.
pkgbase=alizy
pkgname=(alizyd alizy)
pkgver=0.2.1
pkgrel=1
pkgdesc="WireGuard desktop client with an OS-level nftables kill switch"
arch=(x86_64 aarch64)
url="https://github.com/jonios/alizy"
license=(GPL-3.0-or-later)
makedepends=(cargo nodejs npm webkit2gtk-4.1)
options=(!lto !debug)
source=()
sha256sums=()

_src() { realpath "$startdir/../.."; }

build() {
  cd "$(_src)"
  export CARGO_TARGET_DIR="$srcdir/target"
  npm ci --no-audit --no-fund
  cargo build --release --locked -p alizyd
  ./node_modules/.bin/tauri build --no-bundle -- --locked
}

check() {
  cd "$(_src)"
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo test --release --locked -p alizy-core -p alizy-store -p alizyd
}

package_alizyd() {
  pkgdesc="Privileged service of a WireGuard client: tunnels, nftables kill switch, DNS and split tunnelling"
  depends=(glibc iproute2 libgcc nftables polkit systemd wireguard-tools)
  optdepends=('openresolv: DNS management on systems without systemd-resolved'
              'openssh: SSH tunnel profiles'
              'badvpn: SSH tunnel profiles (badvpn-tun2socks)')
  install=alizyd.install
  local s; s="$(_src)"
  install -Dm755 "$srcdir/target/release/alizyd" -t "$pkgdir/usr/bin/"
  install -Dm644 "$s/packaging/linux/alizyd.service" -t "$pkgdir/usr/lib/systemd/system/"
  install -Dm644 "$s/packaging/linux/alizy.sysusers" "$pkgdir/usr/lib/sysusers.d/alizy.conf"
  install -Dm644 "$s/packaging/linux/io.alizy.policy" -t "$pkgdir/usr/share/polkit-1/actions/"
  install -Dm644 "$s/SECURITY.md" -t "$pkgdir/usr/share/doc/alizyd/"
}

package_alizy() {
  pkgdesc="WireGuard desktop client with an OS-level nftables kill switch (unprivileged GUI)"
  depends=("alizyd=$pkgver" cairo dbus gdk-pixbuf2 glib2 glibc gtk3 libgcc
           hicolor-icon-theme libsoup3 webkit2gtk-4.1)
  optdepends=('libayatana-appindicator: system tray icon'
              'org.freedesktop.secrets: keep private keys in the desktop keyring (GNOME Keyring, KWallet, KeePassXC)')
  local s size; s="$(_src)"
  install -Dm755 "$srcdir/target/release/alizy" -t "$pkgdir/usr/bin/"
  install -Dm644 "$s/packaging/linux/io.alizy.app.desktop" -t "$pkgdir/usr/share/applications/"
  for size in 32 64 128; do
    install -Dm644 "$s/src-tauri/icons/${size}x${size}.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/io.alizy.app.png"
  done
  install -Dm644 "$s/src-tauri/icons/128x128@2x.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/io.alizy.app.png"
  install -Dm644 "$s/src-tauri/icons/icon.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/io.alizy.app.png"
  install -Dm644 "$s/src-tauri/icons/alizy.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.alizy.app.svg"
  install -Dm644 "$s/README.md" -t "$pkgdir/usr/share/doc/alizy/"
}
