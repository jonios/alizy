post_install() {
  systemctl daemon-reload
  echo ">>> Enable the service:        sudo systemctl enable --now alizyd"
  echo ">>> Allow your user to use it: sudo usermod -aG alizy \$USER"
  echo ">>> Then REBOOT (a re-login is not enough when the systemd user manager"
  echo ">>> lingers, e.g. loginctl enable-linger / uwsm sessions)."
  echo ">>> Kill switch blocking the network?  sudo alizyd --remove-firewall"
}
post_upgrade() {
  systemctl daemon-reload
  local was_active=0
  systemctl -q is-active alizyd.service && was_active=1
  systemctl try-restart alizyd.service
  # An upgrade must never leave a kill switch in the kernel that nothing is
  # managing: if the service was running before and did not come back, drop
  # Alizy's own rules rather than black-hole the network. A service that was
  # deliberately stopped keeps its protection (fail closed), so it is left
  # alone here.
  if [ "$was_active" -eq 1 ] && ! systemctl -q is-active alizyd.service; then
    /usr/bin/alizyd --remove-firewall 2>/dev/null || true
    echo ">>> alizyd did not come back after the upgrade; its nftables rules were"
    echo ">>> removed so the network stays reachable. Bring it back with:"
    echo ">>>     sudo systemctl enable --now alizyd"
  fi
}
pre_remove() {
  systemctl disable --now alizyd.service 2>/dev/null || true
  /usr/bin/alizyd --remove-firewall 2>/dev/null || true
}
