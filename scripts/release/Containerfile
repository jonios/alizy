# Release build environment: Ubuntu 22.04 (glibc 2.35, WebKitGTK 4.1).
# Binaries built here run on Ubuntu 22.04+, Debian 12+, Fedora 36+, current
# Arch and other distributions with glibc >= 2.35. GitHub Actions uses the
# same base (runs-on: ubuntu-22.04) with the same package list.
# Build context: scripts/release (podman build -f Containerfile scripts/release).
FROM docker.io/library/ubuntu:22.04

ARG RUST_VERSION=1.100.0
ARG NODE_VERSION=24.22.3
ENV DEBIAN_FRONTEND=noninteractive \
    PATH=/opt/cargo/bin:/opt/node/bin:$PATH \
    CARGO_HOME=/opt/cargo \
    RUSTUP_HOME=/opt/rustup

COPY build-deps.txt /tmp/build-deps.txt
RUN apt-get update \
 && xargs -a /tmp/build-deps.txt apt-get install -y --no-install-recommends \
 && rm -rf /var/lib/apt/lists/*

# Node.js: official tarball, verified against the release's SHASUMS256.txt.
RUN cd /tmp \
 && curl -fsSLO "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
 && curl -fsSLO "https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt" \
 && grep " node-v${NODE_VERSION}-linux-x64.tar.xz\$" SHASUMS256.txt | sha256sum -c - \
 && mkdir -p /opt/node && tar -xJf "node-v${NODE_VERSION}-linux-x64.tar.xz" -C /opt/node --strip-components=1 \
 && rm -f node-v*.tar.xz SHASUMS256.txt

# Rust: rustup (HTTPS from static.rust-lang.org), pinned toolchain.
RUN curl -fsSL https://sh.rustup.rs -o /tmp/rustup-init.sh \
 && sh /tmp/rustup-init.sh -y --no-modify-path --profile minimal --default-toolchain "${RUST_VERSION}" \
 && rm /tmp/rustup-init.sh \
 && chmod -R a+rwX /opt/cargo /opt/rustup

WORKDIR /src
